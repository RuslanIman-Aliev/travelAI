// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lifecycle of an itinerary. `generating` is claimed atomically before the
/// background job is enqueued, so a second request cannot start a duplicate run.
enum TripStatus {
  draft
  generating
  generated
  failed
}

// For Authentication (NextAuth.js)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  trips         Trip[]
  liveGuides    LiveGuide[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Regular application models
model Trip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  /// User-chosen name for the trip. Falls back to `destination` when unset, so
  /// existing trips keep reading exactly as they did.
  title       String?
  destination String
  country     String?
  /// Calendar days, not instants. Stored as `date` so a trip cannot drift to the
  /// previous day when it is read back in a different timezone.
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  daysCount   Int
  imageUrl    String?

  // Budget is captured as a structured range so it never has to be re-parsed
  // from free text at render time.
  budgetMin      Int?
  budgetMax      Int?
  budgetCurrency String?

  interests   String[]

  /// The one record of where a trip is. An `aiGenerated` boolean used to sit
  /// beside this saying `status == "generated"` a second time, which meant the
  /// claim condition, the trip page and the dashboard filter all had to keep two
  /// columns agreeing to stay correct.
  status      TripStatus @default(draft)

  tripDays    Day[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Both indexes end in `createdAt` because every listing query orders by it.
  // Indexing only the filter columns left Postgres sorting the matched rows on
  // every page of the dashboard.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

model Day {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  dayNumber Int
  date      DateTime? @db.Date
  summary   String?

  activities Activity[]

  // Guarantees a retried generation job cannot insert a second copy of a day.
  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model Activity {
  id                String  @id @default(cuid())
  dayId             String
  day               Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  time              String?

  placeName         String?
  placeType         String?

  latitude          Float?
  longitude         Float?

  // Money is stored as integer minor units (cents) rather than free text, so the
  // LLM's "20 EUR" is parsed exactly once on ingestion instead of on every render.
  estimatedCostCents    Int?
  estimatedCostCurrency String?
  estimatedCostIsFree   Boolean @default(false)

  order             Int
  /// The order the user arranged this day into, when they have. Kept separate
  /// from `order` so a regenerated itinerary does not silently inherit a manual
  /// arrangement of activities that no longer exist.
  userOrder         Int?

  @@index([dayId])
}

model LiveGuide {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  startAddress  String?   
  startLat      Float     
  startLng      Float     
  
  radiusMeters  Int       
  
  places        LiveGuidePlace[]
  mapLink     String? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model LiveGuidePlace {
  id            String    @id @default(cuid())
  liveGuideId   String
  liveGuide     LiveGuide @relation(fields: [liveGuideId], references: [id], onDelete: Cascade)

  googlePlaceId String    
  name          String
  address       String?
  category      String?   
  
  rating        Float?
  userRatingCount Int?

  lat           Float
  lng           Float
  distance      Float?

  orderIndex    Int

  @@index([liveGuideId])
}