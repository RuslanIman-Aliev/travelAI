# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/travel_ai"

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI -----------------------------------------------------------------
GEMINI_API_KEY=""

# --- Google Maps --------------------------------------------------------
# Two separate keys on purpose.
#
# The browser key ships inside the JS bundle, so it must be restricted by HTTP
# referrer and limited to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
#
# The Places key is used only from the server. It must NOT carry the
# NEXT_PUBLIC_ prefix, and should be restricted by IP and to the Places API.
GOOGLE_PLACES_API_KEY=""

# --- Images -------------------------------------------------------------
PEXELS_API_KEY=""

# --- Reverse geocoding --------------------------------------------------
# Nominatim's usage policy requires an identifying contact address.
NOMINATIM_CONTACT="you@example.com"

# --- Background jobs ----------------------------------------------------
INNGEST_EVENT_KEY=""

# --- E2E only -----------------------------------------------------------
# Enables a cookie-based sign-in shortcut for Playwright. Ignored entirely when
# NODE_ENV=production - see `isTestAuthEnabled` in auth.ts.
# ENABLE_TEST_AUTH="true"
# E2E_TEST_EMAIL="e2e@travel-ai.local"
# E2E_TEST_NAME="E2E User"
