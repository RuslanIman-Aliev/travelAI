# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/travel_ai"

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI -----------------------------------------------------------------
GEMINI_API_KEY=""

# Optional. Defaults to gemini-3-flash-preview.
# GEMINI_MODEL="gemini-3-flash-preview"

# Optional. MINIMAL | LOW | MEDIUM | HIGH, defaults to LOW.
# Gemini 3 reasons before answering and that reasoning dominates generation
# latency. LOW is the default compromise; MINIMAL is faster but tends to hurt
# coordinate accuracy and budget adherence. Compare with the token breakdown the
# generation step logs before changing this.
# GEMINI_THINKING_LEVEL="LOW"

# Optional. The most the model will emit in one response, defaults to 65536.
# The per-request ceiling is computed from the trip length and the response
# schema's own bounds, then clamped to this. Set it when GEMINI_MODEL points at
# a model with a different output limit - too low and a long itinerary is cut
# off mid-JSON, which fails the whole generation rather than shortening it.
# GEMINI_MAX_OUTPUT_TOKENS="65536"

# --- Google Maps --------------------------------------------------------
# Two separate keys on purpose.
#
# The browser key ships inside the JS bundle, so it must be restricted by HTTP
# referrer and limited to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
#
# The Places key is used only from the server. It must NOT carry the
# NEXT_PUBLIC_ prefix, and should be restricted by IP.
#
# Two APIs have to be enabled on it: Places API (New) for the Live Guide search,
# and Geocoding API for turning the browser's coordinates into an address. A key
# missing the second answers HTTP 200 with `status: "REQUEST_DENIED"`, so a
# misconfiguration shows up as "unable to retrieve your location" rather than as
# a failed request.
GOOGLE_PLACES_API_KEY=""

# --- Images -------------------------------------------------------------
PEXELS_API_KEY=""

# --- Background jobs ----------------------------------------------------
INNGEST_EVENT_KEY=""

# --- E2E only -----------------------------------------------------------
# Enables a cookie-based sign-in shortcut for Playwright. Ignored entirely when
# NODE_ENV=production - see `isTestAuthEnabled` in auth.ts.
# ENABLE_TEST_AUTH="true"
# E2E_TEST_EMAIL="e2e@travel-ai.local"
# E2E_TEST_NAME="E2E User"
